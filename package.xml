<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>admittance_controller</name>
  <version>0.1.0</version>
  <description>
    Admittance controller for Kinova Gen3 using direct Kortex API.
    Reads wrench from BaseCyclic feedback and converts force to
    position offsets for compliant behavior.
  </description>
  <maintainer email="sahil@todo.com">Sahil</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>kinova_wrapper</depend>
  <depend>rcl_interfaces</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
